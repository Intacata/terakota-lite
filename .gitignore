# Dependencies
node_modules/

# Generated project build outputs (NOT the CLI bundle)
build/
.next/
out/
.turbo

# Ignore dist/ folders EXCEPT the compiled CLI bundle
# Note: negation after a parent-dir rule doesn't work in git.
# So we list specific dist patterns to ignore rather than ignoring dist/ broadly.
packages/templates/*/dist/
packages/templates/*/.next/
scripts/dist/

# Keep the compiled CLI bundle tracked — users need it without any build step
# packages/create-terakota/dist/index.cjs  ← always tracked, never ignored

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Editor
.vscode/
.idea/
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage
coverage/
*.lcov

# Release archives (generated locally, not committed to branch)
*.zip
*.tar.gz

# Testing
.vitest/
