{
    "name": "create-terakota",
    "version": "1.0.0",
    "description": "Official scaffolding CLI for Terakota Foundation — create any variant in seconds",
    "keywords": [
        "terakota",
        "scaffold",
        "template",
        "react",
        "vite",
        "nextjs",
        "mui",
        "electron",
        "pwa"
    ],
    "author": "Terakota by NG0-GabrielOnike <terakota@ngonike.dev>",
    "license": "MIT",
    "type": "module",
    "bin": {
        "create-terakota": "./dist/index.js"
    },
    "files": [
        "dist",
        "templates"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "pnpm build"
    },
    "dependencies": {
        "chalk": "^5.3.0",
        "commander": "^12.1.0",
        "execa": "^9.4.0",
        "fs-extra": "^11.2.0",
        "ora": "^8.1.1",
        "prompts": "^2.4.2"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^22.0.0",
        "@types/prompts": "^2.4.9",
        "tsup": "^8.5.1",
        "typescript": "^5.5.0"
    },
    "tsup": {
        "entry": [
            "src/index.ts"
        ],
        "format": [
            "esm"
        ],
        "target": "node18",
        "banner": {
            "js": "#!/usr/bin/env node"
        },
        "clean": true,
        "shims": true
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
